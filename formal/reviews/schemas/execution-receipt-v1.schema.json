{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fanilosendrison:turnlock-rust:hostile-review-execution-receipt:1",
  "title": "TURNLOCK hostile-review execution receipt (schema version 1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema_version",
    "execution_id",
    "role",
    "reviewer_profile_id",
    "protocol_bundle_sha256",
    "input",
    "isolated_context",
    "cross_reviewer_visibility_before_seal",
    "tools_enabled",
    "runtime",
    "request",
    "attempts",
    "qualifying_attempt_id",
    "resolved_identity"
  ],
  "properties": {
    "receipt_schema_version": {
      "const": "1.0"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "initial-reviewer",
        "materiality-assessor",
        "refutation-builder",
        "challenge",
        "discovery-classifier",
        "derivation-builder",
        "decision-necessity-challenger",
        "repair-synthesizer",
        "decision-projection"
      ]
    },
    "reviewer_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "packet"
      ],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/artifactReference"
        },
        "packet": {
          "$ref": "#/$defs/artifactReference"
        }
      }
    },
    "isolated_context": {
      "const": true
    },
    "cross_reviewer_visibility_before_seal": {
      "const": false
    },
    "tools_enabled": {
      "const": false
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "qualifying_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_identity": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/resolvedIdentity"
        }
      ]
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "call_id",
        "outcome",
        "started_at",
        "ended_at",
        "provider_model",
        "provider_response_id",
        "termination",
        "transport_attempt_count",
        "raw_output",
        "protocol_errors"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "technical-failure",
            "protocol-invalid",
            "qualified"
          ]
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "ended_at": {
          "type": "string",
          "minLength": 1
        },
        "provider_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_response_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "termination": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_attempt_count": {
          "type": "integer",
          "minimum": 1
        },
        "raw_output": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/artifactReference"
            }
          ]
        },
        "protocol_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resolvedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "model_version",
        "resolution_kind",
        "evidence_attempt_id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "resolution_kind": {
          "enum": [
            "provider-reported",
            "pinned-request-model"
          ]
        },
        "evidence_attempt_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
